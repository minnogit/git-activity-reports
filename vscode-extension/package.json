{
  "name": "git-activity-reports",
  "displayName": "Git Activity Reports",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "minnoit",
  "repository": {
    "type": "git",
    "url": "https://github.com/minnogit/git-activity-reports.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-activity.analyzeProject",
        "title": "%command.analyzeProject.title%",
        "category": "Git Activity"
      },
      {
        "command": "git-activity.analyzeWorkspace",
        "title": "%command.analyzeWorkspace.title%",
        "category": "Git Activity"
      },
      {
        "command": "git-activity.analyzeMyWork",
        "title": "%command.analyzeMyWork.title%",
        "category": "Git Activity"
      }
    ],
    "configuration": {
      "title": "Git Activity Reports",
      "properties": {
        "git-activity.startDate": {
          "type": "string",
          "default": "30 days ago",
          "description": "%config.startDate%"
        },
        "git-activity.endDate": {
          "type": "string",
          "default": "now",
          "description": "%config.endDate%"
        },
        "git-activity.outputDir": {
          "type": "string",
          "default": "",
          "description": "%config.outputDir%"
        },
        "git-activity.author": {
          "type": "string",
          "default": "",
          "description": "%config.author%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run copy-bundled && npm run compile",
    "copy-bundled": "node ./scripts/copy-bundled.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "16.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^8.41.0",
    "mocha": "^10.8.2",
    "typescript": "^5.1.3"
  },
  "l10n": "./l10n",
  "keywords": [
    "git",
    "statistics",
    "commits",
    "activity",
    "report",
    "chart",
    "contributors",
    "analytics"
  ],
  "bugs": {
    "url": "https://github.com/minnogit/git-activity-reports/issues"
  },
  "homepage": "https://github.com/minnogit/git-activity-reports#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrusted%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtual%"
    }
  }
}
